{
    "version": "0.2.0",
    "configurations": [
      {
        "name": "HelpDeskWeb (Kestrel)",
        "type": "coreclr",
        "request": "launch",
        "preLaunchTask": "build+ef",
        "program": "${workspaceFolder}/bin/Debug/net8.0/HelpDeskWeb.dll",
        "args": [],
        "cwd": "${workspaceFolder}",
        "env": {
          "ASPNETCORE_ENVIRONMENT": "Development",
          "ASPNETCORE_URLS": "https://localhost:7288;http://localhost:5288"
        },
        "serverReadyAction": {
          "action": "openExternally",
          "pattern": "Now listening on:\\s+(https?://\\S+)"
        },
        "stopAtEntry": false,
        "console": "integratedTerminal"
      }
    ]
  }
  