{
    "version": "2.0.0",
    "tasks": [
      {
        "label": "kill-HelpDeskWeb",
        "type": "shell",
        "command": "Get-Process HelpDeskWeb -ErrorAction SilentlyContinue | Stop-Process -Force; exit 0",
        "problemMatcher": []
      },
      {
        "label": "build",
        "type": "process",
        "command": "dotnet",
        "args": ["build", "${workspaceFolder}/HelpDeskWeb.csproj", "/property:GenerateFullPaths=true", "/consoleloggerparameters:NoSummary"],
        "problemMatcher": "$msCompile",
        "dependsOn": "kill-HelpDeskWeb"
      },
      {
        "label": "ef-update",
        "type": "process",
        "command": "dotnet",
        "args": [
          "ef", "database", "update",
          "--project", "${workspaceFolder}/HelpDeskWeb.csproj",
          "--startup-project", "${workspaceFolder}/HelpDeskWeb.csproj"
        ]
      },
      {
        "label": "build+ef",
        "dependsOrder": "sequence",
        "dependsOn": ["build", "ef-update"]
      }
    ]
  }
  