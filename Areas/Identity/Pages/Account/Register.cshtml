@page
@model HelpDeskWeb.Areas.Identity.Pages.Account.RegisterModel
@{
    ViewData["Title"] = "Cadastrar";
}

<div class="panel">
  <h2 class="m0">Criar conta</h2>
  <form method="post" class="mt12">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="row">
      <div class="col-12">
        <label>E-mail</label>
        <input asp-for="Input.Email" type="email" autocomplete="username" />
        <span asp-validation-for="Input.Email" class="text-danger"></span>
      </div>

      <div class="col-6">
        <label>Senha</label>
        <input asp-for="Input.Password" type="password" autocomplete="new-password" />
        <span asp-validation-for="Input.Password" class="text-danger"></span>
      </div>

      <div class="col-6">
        <label>Confirmar senha</label>
        <input asp-for="Input.ConfirmPassword" type="password" autocomplete="new-password" />
        <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
      </div>
    </div>

    <div class="mt16">
      <button class="btn primary" type="submit">Cadastrar</button>
      <a class="btn ghost" asp-area="Identity" asp-page="/Account/Login" asp-route-returnUrl="@Model.ReturnUrl">Já tenho conta</a>
    </div>
  </form>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
